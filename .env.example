# ==============================================================================
# Job Hunter Agent - Environment Configuration
# Copy this file to .env and replace placeholders with your actual credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Application Settings
APP_NAME="Job Hunter Agent"
APP_ENV="development" # development | production | test
DEBUG=false
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string"

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite+aiosqlite:///./data/job_hunter.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://job_user:secure_password@localhost:5432/job_hunter"

# Timezone Configuration (IANA Timezone Name)
TIMEZONE="Africa/Cairo"
DAILY_DIGEST_TIME="09:00"

# Telegram Bot Configuration
# Obtain BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz_placeholder"
# Numeric Telegram user ID of candidate (get from @userinfobot)
TELEGRAM_OWNER_ID=123456789
TELEGRAM_POLLING=true

# Google Gemini AI Configuration (for structured attribute extraction)
# Obtain API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EXTRACTION_ENABLED=true
GEMINI_MAX_REQUESTS_PER_RUN=25

# Candidate Geography Defaults
CANDIDATE_COUNTRY="EG"
CANDIDATE_TIMEZONE="Africa/Cairo"

# Match Thresholds (0 - 100)
MATCH_THRESHOLD_DIGEST=70.0
MATCH_THRESHOLD_STORE=50.0

# Preconfigured Public Career Boards (JSON list of tokens/slugs)
GREENHOUSE_BOARD_TOKENS='["canonical", "cloudflare", "reddit"]'
LEVER_COMPANY_SLUGS='["palantir"]'
RSS_JOB_FEEDS='["https://weworkremotely.com/categories/remote-front-end-programming-jobs.rss"]'
